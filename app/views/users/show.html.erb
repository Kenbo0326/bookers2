<h1>User Profile</h1>

<p>名前: <%= @user.name %></p>
<p>紹介文: <%= @user.introduction %></p>

<% if @user == Current.user %>
  <%= link_to "Edit Profile", edit_user_path(@user) %>
<% end %>

<hr>

<h2>このユーザーの投稿一覧</h2>

<table>
  <thead>
    <tr>
      <th>タイトル</th>
      <th>本文</th>
      <th></th>
    </tr>
  </thead>

  <tbody>
    <% @user.books.each do |book| %>
      <tr>
        <td><%= book.title %></td>
        <td><%= book.body %></td>
        <td><%= link_to "Show", book_path(book) %></td>
      </tr>
    <% end %>
  </tbody>
</table>