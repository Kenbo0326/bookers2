<div class="container mt-4">
  <div class="row">

    <!-- 左側：User info + New book（部分テンプレート） -->
    <div class="col-md-3">
      <%= render "books/user_info", user: @user, book_new: @book_new %>
    </div>

    <!-- 右側：User の投稿一覧 -->
    <div class="col-md-9">
      <h2><%= @user.name %>'s Books</h2>

      <table class="table table-striped">
        <thead>
          <tr>
            <th>Image</th>
            <th>Title</th>
            <th>Body</th>
            <th>Show</th>
          </tr>
        </thead>

        <tbody>
          <% @books.each do |book| %>
            <tr>
              <td>
                <% if @user.profile_image.attached? %>
                  <%= image_tag @user.profile_image, size: "50x50" %>
                <% else %>
                  <%= image_tag "no_image.jpg", size: "50x50" %>
                <% end %>
              </td>

              <td><%= book.title %></td>
              <td><%= book.body %></td>

              <td>
                <%= link_to "Show", book_path(book), class: "btn btn-outline-primary" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>

    </div>

  </div>
</div>
