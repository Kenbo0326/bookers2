<h2>Users</h2>

<table class="table">
  <thead>
    <tr>
      <th>Profile Image</th>
      <th>Name</th>
      <th></th>
    </tr>
  </thead>

  <tbody>
    <% @users.each do |user| %>
      <tr>
        <td>
          <% if user.profile_image.attached? %>
            <%= image_tag user.profile_image, size: "60x60", class: "rounded-circle" %>
          <% else %>
            <%= image_tag "no_image.jpg", size: "60x60", class: "rounded-circle" %>
          <% end %>
        </td>

        <td><%= user.name %></td>

        <td><%= link_to "Show", user_path(user), class: "btn btn-sm btn-primary" %></td>
      </tr>
    <% end %>
  </tbody>
</table>
