<div class="container mt-4">
  <div class="row">

    <!-- 左側：User info + New book（部分テンプレート） -->
    <div class="col-md-3">
      <%= render "books/user_info", user: @user, book_new: @book_new %>
    </div>

    <!-- 右側：Users 一覧 -->
    <div class="col-md-9">
      <h2>Users</h2>

      <table class="table table-striped">
        <thead>
          <tr>
            <th>Image</th>
            <th>Name</th>
            <th>Show</th>
          </tr>
        </thead>

        <tbody>
          <% @users.each do |user| %>
            <tr>
              <td>
                <% if user.profile_image.attached? %>
                  <%= image_tag user.profile_image, size: "50x50" %>
                <% else %>
                  <%= image_tag "no_image.jpg", size: "50x50" %>
                <% end %>
              </td>

              <td><%= user.name %></td>

              <td>
                <%= link_to "Show", user_path(user), class: "btn btn-outline-primary" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>

    </div>

  </div>
</div>
