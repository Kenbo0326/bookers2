<h1>Books</h1>

<!-- エラーメッセージ表示 -->
<% if @book.errors.any? %>
  <div class="error-messages">
    <h2><%= @book.errors.count %> errors prohibited this book from being saved:</h2>
    <ul>
      <% @book.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<!-- 新規投稿フォーム -->
<%= form_with model: @book, local: true do |f| %>
  <div>
    <%= f.label :title %>
    <%= f.text_field :title %>
  </div>

  <div>
    <%= f.label :body %>
    <%= f.text_area :body %>
  </div>

  <%= f.submit "Create Book" %>
<% end %>

<hr>

<!-- 投稿一覧 -->
<table>
  <thead>
    <tr>
      <th>投稿者</th>
      <th>タイトル</th>
      <th>本文</th>
      <th></th>
    </tr>
  </thead>

  <tbody>
    <% @books.each do |book| %>
      <tr>
        <td><%= book.user.name %></td>
        <td><%= book.title %></td>
        <td><%= book.body %></td>
        <td>
          <%= link_to "Show", book_path(book) %> |
          <%= link_to "Destroy", book_path(book), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class:  "btn btn-danger" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
