<h2>Books</h2>

<div class="row">
  <div class="col-md-4">
    <h3>New Book</h3>

    <%= form_with model: @book do |f| %>
      <div class="mb-3">
        <%= f.label :title %>
        <%= f.text_field :title, class: "form-control" %>
      </div>

      <div class="mb-3">
        <%= f.label :body %>
        <%= f.text_area :body, class: "form-control" %>
      </div>

      <%= f.submit "Create Book", class: "btn btn-primary" %>
    <% end %>
  </div>

  <div class="col-md-8">
    <h3>Book List</h3>

    <table class="table">
      <thead>
        <tr>
          <th>Title</th>
          <th>Body</th>
          <th>User</th>
          <th></th>
        </tr>
      </thead>

      <tbody>
        <% @books.each do |book| %>
          <tr>
            <td><%= link_to book.title, book_path(book) %></td>
            <td><%= book.body %></td>
            <td><%= link_to book.user.name, user_path(book.user) %></td>
            <td>
              <% if book.user == current_user %>
                <%= link_to "Edit", edit_book_path(book), class: "btn btn-sm btn-secondary" %>
                <%= link_to "Delete", book_path(book), method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-sm btn-danger" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
