<h2>New Book</h2>

<%= form_with model: @book do |f| %>
  <div class="mb-3">
    <%= f.label :title %>
    <%= f.text_field :title, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :body %>
    <%= f.text_area :body, class: "form-control" %>
  </div>

  <%= f.submit "Create Book", class: "btn btn-primary" %>
<% end %>

<%= link_to "Back", books_path, class: "btn btn-link" %>
