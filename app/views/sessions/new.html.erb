<h2>ログイン</h2>

<%= form_with url: sessions_path, local: true do |f| %>
  <div class="mb-3">
    <%= f.label :name, "名前" %>
    <%= f.text_field :name, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :password, "パスワード" %>
    <%= f.password_field :password, class: "form-control" %>
  </div>

  <%= f.submit "ログイン", class: "btn btn-primary" %>
<% end %>